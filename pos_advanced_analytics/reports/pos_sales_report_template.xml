<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_sales_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="payload" t-value="doc._report_payload()"/>
                <t t-set="sections" t-value="payload.get('sections', [])"/>
                <t t-set="kpis" t-value="payload.get('kpis', {})"/>
                <t t-set="refund" t-value="payload.get('refund_discount_summary', {})"/>
                <t t-set="payment" t-value="payload.get('payment_analytics', {})"/>
                <t t-set="tax" t-value="payload.get('tax_details', {})"/>
                <t t-set="daily" t-value="payload.get('daily_closing_details', {})"/>
                <t t-call="web.external_layout">
                    <style>
                        .paa-page { font-size: 10px; color: #111827; }
                        .paa-title { font-size: 21px; font-weight: 700; margin-bottom: 4px; }
                        .paa-meta td { padding: 2px 6px; font-size: 9px; }
                        .paa-kpi-grid { display: table; width: 100%; border-spacing: 5px; margin: 8px 0; }
                        .paa-kpi { display: table-cell; width: 25%; background: #f3f4f6; border: 1px solid #e5e7eb; padding: 6px; }
                        .paa-kpi-label { font-size: 8px; text-transform: uppercase; color: #6b7280; }
                        .paa-kpi-value { font-size: 13px; font-weight: 700; color: #111827; }
                        .paa-section { page-break-inside: avoid; margin-top: 11px; }
                        .paa-break { page-break-before: always; }
                        table.paa-table { width: 100%; border-collapse: collapse; font-size: 8px; margin-top: 4px; }
                        table.paa-table th { background: #1f4e79; color: white; padding: 3px; border: 1px solid #d1d5db; }
                        table.paa-table td { padding: 2px; border: 1px solid #d1d5db; vertical-align: top; }
                    </style>
                    <div class="page paa-page">
                        <div class="paa-title"><t t-esc="payload.get('report_title')"/></div>
                        <p>Executive POS sales and operational analytics report. Basis: <strong t-esc="payload.get('basis_label')"/>.</p>
                        <table class="paa-meta">
                            <tr><td><strong>Date Range</strong></td><td><span t-esc="payload.get('filters', {}).get('date_start')"/> to <span t-esc="payload.get('filters', {}).get('date_end')"/></td><td><strong>Branch</strong></td><td><span t-esc="payload.get('branch_filter')"/></td></tr>
                            <tr><td><strong>Generated By</strong></td><td><span t-esc="payload.get('generated_by')"/></td><td><strong>Generated</strong></td><td><span t-esc="payload.get('generated_at')"/></td></tr>
                            <tr><td><strong>Timezone</strong></td><td><span t-esc="payload.get('filters', {}).get('timezone')"/></td><td><strong>Group By</strong></td><td><span t-esc="payload.get('group_by_label')"/></td></tr>
                        </table>

                        <t t-if="'kpis' in sections">
                            <div class="paa-section"><h3>KPI Summary</h3>
                                <div class="paa-kpi-grid">
                                    <div class="paa-kpi"><div class="paa-kpi-label">Selected Basis</div><div class="paa-kpi-value" t-esc="doc._format_report_value(kpis.get('basis_metric'))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Net Sales</div><div class="paa-kpi-value" t-esc="doc._format_report_value(kpis.get('net_sales'))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Orders</div><div class="paa-kpi-value" t-esc="doc._format_report_value(kpis.get('total_orders'))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">AOV</div><div class="paa-kpi-value" t-esc="doc._format_report_value(kpis.get('average_order_value'))"/></div>
                                </div>
                                <div class="paa-kpi-grid">
                                    <div class="paa-kpi"><div class="paa-kpi-label">Discounts</div><div class="paa-kpi-value" t-esc="doc._format_report_value(kpis.get('total_discounts'))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Refunds</div><div class="paa-kpi-value" t-esc="doc._format_report_value(kpis.get('total_refunds'))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Tax</div><div class="paa-kpi-value" t-esc="doc._format_report_value(kpis.get('total_tax'))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Peak Hour</div><div class="paa-kpi-value" t-esc="kpis.get('peak_sales_hour')"/></div>
                                </div>
                            </div>
                        </t>

                        <t t-if="'target_summary' in sections and payload.get('target_summary')">
                            <t t-set="target" t-value="payload.get('target_summary', {})"/>
                            <t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Target Achievement'"/><t t-set="rows" t-value="[target]"/><t t-set="cols" t-value="[('monthly_target','Target'),('actual_sales','Actual'),('achievement_percentage','Ach %'),('remaining_target','Remaining'),('required_average_daily_sales','Required Daily'),('orders_target_achievement','Orders %'),('avg_order_value_target_achievement','AOV %')]"/></t>
                        </t>

                        <t t-if="'grouped' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Grouped Summary'"/><t t-set="rows" t-value="payload.get('grouped_report', [])"/><t t-set="cols" t-value="[('group_label','Group'),('total_sales','Basis'),('net_sales','Net'),('order_count','Orders'),('quantity_sold','Qty'),('average_order_value','AOV'),('tax','Tax'),('refunds','Refunds'),('discounts','Discounts'),('percentage','Share %')]"/></t></t>
                        <t t-if="'sales_trend' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Sales Trend'"/><t t-set="rows" t-value="payload.get('sales_trend', [])"/><t t-set="cols" t-value="[('label','Period'),('total_sales','Basis'),('net_sales','Net'),('order_count','Orders'),('tax_amount','Tax')]"/></t></t>
                        <t t-if="'top_products' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Product Sales'"/><t t-set="rows" t-value="payload.get('top_products', [])"/><t t-set="cols" t-value="[('product_name','Product'),('category_name','Category'),('quantity_sold','Qty'),('basis_amount','Basis'),('gross_sales','Gross'),('net_sales','Net'),('discount_amount','Discount'),('refund_quantity','Refund Qty'),('refund_amount','Refund'),('average_unit_price','Avg Unit')]"/></t></t>
                        <t t-if="'top_categories' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Category Sales'"/><t t-set="rows" t-value="payload.get('top_categories', [])"/><t t-set="cols" t-value="[('category_name','Category'),('quantity_sold','Qty'),('basis_amount','Basis'),('gross_sales','Gross'),('net_sales','Net'),('discount_amount','Discount'),('refund_quantity','Refund Qty'),('refund_amount','Refund'),('product_count','Products')]"/></t></t>
                        <t t-if="'waiter_performance' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Waiter Performance'"/><t t-set="rows" t-value="payload.get('waiter_performance', [])"/><t t-set="cols" t-value="[('waiter_name','Waiter'),('total_sales','Basis'),('total_orders','Orders'),('average_order_value','AOV'),('quantity_sold','Qty'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'cashier_performance' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Cashier Performance'"/><t t-set="rows" t-value="payload.get('cashier_performance', [])"/><t t-set="cols" t-value="[('cashier_name','Cashier'),('total_sales','Basis'),('total_collected','Collected'),('number_of_orders','Orders'),('average_ticket_size','Avg Ticket'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'branch_comparison' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Branch Comparison'"/><t t-set="rows" t-value="payload.get('branch_comparison', [])"/><t t-set="cols" t-value="[('branch_name','Branch'),('total_sales','Basis'),('net_sales','Net'),('total_orders','Orders'),('average_order_value','AOV'),('top_product','Top Product'),('top_category','Top Category'),('peak_hour','Peak Hour'),('peak_day','Peak Day')]"/></t></t>
                        <t t-if="'peak_hours' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Peak Hours'"/><t t-set="rows" t-value="payload.get('peak_hours', [])"/><t t-set="cols" t-value="[('label','Hour'),('order_count','Orders'),('sales_amount','Basis'),('net_sales','Net'),('average_order_value','AOV')]"/></t></t>
                        <t t-if="'peak_days' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Peak Days'"/><t t-set="rows" t-value="payload.get('peak_days', [])"/><t t-set="cols" t-value="[('label','Day'),('order_count','Orders'),('sales_amount','Basis'),('net_sales','Net'),('average_order_value','AOV')]"/></t></t>

                        <t t-if="'payment_methods' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Payment Method Summary'"/><t t-set="rows" t-value="payment.get('summary', payload.get('payment_methods', []))"/><t t-set="cols" t-value="[('payment_method_name','Method'),('method_type','Category'),('order_count','Orders'),('amount','Collected'),('percentage','Share %')]"/></t></t>
                        <t t-if="'payment_breakdowns' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Payment by Branch'"/><t t-set="rows" t-value="payment.get('branch_breakdown', [])"/><t t-set="cols" t-value="[('group_label','Branch'),('payment_method_name','Method'),('order_count','Orders'),('amount','Collected')]"/></t><t t-if="payload.get('settings', {}).get('enable_cashier_analytics')"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Payment by Cashier'"/><t t-set="rows" t-value="payment.get('cashier_breakdown', [])"/><t t-set="cols" t-value="[('group_label','Cashier'),('payment_method_name','Method'),('order_count','Orders'),('amount','Collected')]"/></t></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Payment by Date'"/><t t-set="rows" t-value="payment.get('date_breakdown', [])"/><t t-set="cols" t-value="[('group_label','Date'),('payment_method_name','Method'),('order_count','Orders'),('amount','Collected')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Payment Category Summary'"/><t t-set="rows" t-value="payment.get('category_summary', [])"/><t t-set="cols" t-value="[('method_type','Category'),('order_count','Orders'),('amount','Collected'),('percentage','Share %')]"/></t></t>

                        <t t-if="'tax_summary' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Tax Summary'"/><t t-set="rows" t-value="payload.get('tax_summary', [])"/><t t-set="cols" t-value="[('branch_name','Branch'),('order_count','Orders'),('tax_amount','Tax')]"/></t></t>
                        <t t-if="'tax_details' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Tax by Date'"/><t t-set="rows" t-value="tax.get('by_date', [])"/><t t-set="cols" t-value="[('group_label','Date'),('order_count','Orders'),('tax_amount','Tax')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Tax by Branch'"/><t t-set="rows" t-value="tax.get('by_branch', [])"/><t t-set="cols" t-value="[('group_label','Branch'),('order_count','Orders'),('tax_amount','Tax')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Tax by Category'"/><t t-set="rows" t-value="tax.get('by_category', [])"/><t t-set="cols" t-value="[('group_label','Category'),('order_count','Orders'),('tax_amount','Tax')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Tax by POS Session'"/><t t-set="rows" t-value="tax.get('by_session', [])"/><t t-set="cols" t-value="[('group_label','Session'),('order_count','Orders'),('tax_amount','Tax')]"/></t></t>

                        <t t-if="'refund_discount' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Refund &amp; Discount Summary'"/><t t-set="rows" t-value="[refund]"/><t t-set="cols" t-value="[('total_refund_amount','Refund Total'),('refund_order_count','Refund Orders'),('refund_quantity','Refund Qty'),('discount_amount','Discount Total'),('discounted_order_count','Discounted Orders')]"/></t></t>
                        <t t-if="'refund_breakdowns' in sections"><div class="paa-break"/><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Refund by Product'"/><t t-set="rows" t-value="refund.get('refund_by_product', [])"/><t t-set="cols" t-value="[('name','Product'),('refund_amount','Refund'),('refund_quantity','Qty'),('order_count','Orders')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Refund by Category'"/><t t-set="rows" t-value="refund.get('refund_by_category', [])"/><t t-set="cols" t-value="[('name','Category'),('refund_amount','Refund'),('refund_quantity','Qty'),('order_count','Orders')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Refund by Cashier'"/><t t-set="rows" t-value="refund.get('refund_by_cashier', [])"/><t t-set="cols" t-value="[('name','Cashier'),('refund_amount','Refund'),('refund_quantity','Qty'),('order_count','Orders')]"/></t><t t-if="payload.get('settings', {}).get('enable_waiter_analytics')"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Refund by Waiter'"/><t t-set="rows" t-value="refund.get('refund_by_waiter', [])"/><t t-set="cols" t-value="[('name','Waiter'),('refund_amount','Refund'),('refund_quantity','Qty'),('order_count','Orders')]"/></t></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Refund by Branch'"/><t t-set="rows" t-value="refund.get('refund_by_branch', [])"/><t t-set="cols" t-value="[('name','Branch'),('refund_amount','Refund'),('refund_quantity','Qty'),('order_count','Orders')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Refund by Date'"/><t t-set="rows" t-value="refund.get('refund_by_date', [])"/><t t-set="cols" t-value="[('name','Date'),('refund_amount','Refund'),('refund_quantity','Qty'),('order_count','Orders')]"/></t></t>
                        <t t-if="'discount_breakdowns' in sections"><div class="paa-break"/><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Discount by Product'"/><t t-set="rows" t-value="refund.get('discount_by_product', [])"/><t t-set="cols" t-value="[('name','Product'),('discount_amount','Discount')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Discount by Category'"/><t t-set="rows" t-value="refund.get('discount_by_category', [])"/><t t-set="cols" t-value="[('name','Category'),('discount_amount','Discount')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Discount by Cashier'"/><t t-set="rows" t-value="refund.get('discount_by_cashier', [])"/><t t-set="cols" t-value="[('name','Cashier'),('discount_amount','Discount')]"/></t><t t-if="payload.get('settings', {}).get('enable_waiter_analytics')"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Discount by Waiter'"/><t t-set="rows" t-value="refund.get('discount_by_waiter', [])"/><t t-set="cols" t-value="[('name','Waiter'),('discount_amount','Discount')]"/></t></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Discount by Branch'"/><t t-set="rows" t-value="refund.get('discount_by_branch', [])"/><t t-set="cols" t-value="[('name','Branch'),('discount_amount','Discount')]"/></t><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Discount by Date'"/><t t-set="rows" t-value="refund.get('discount_by_date', [])"/><t t-set="cols" t-value="[('name','Date'),('discount_amount','Discount')]"/></t></t>

                        <t t-if="'daily_closing' in sections"><div class="paa-break"/><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Summary'"/><t t-set="rows" t-value="daily.get('summary', [])"/><t t-set="cols" t-value="[('business_date','Date'),('branch_name','Branch'),('session_name','Session'),('cashier_name','Cashier'),('total_sales','Basis'),('total_collected','Collected'),('total_orders','Orders'),('refunds','Refunds'),('discounts','Discounts'),('tax','Tax'),('average_order_value','AOV')]"/></t></t>
                        <t t-if="'daily_closing_payments' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Payment Breakdown'"/><t t-set="rows" t-value="daily.get('payments', [])"/><t t-set="cols" t-value="[('branch_name','Branch'),('session_name','Session'),('payment_method_name','Method'),('order_count','Orders'),('amount','Amount')]"/></t></t>
                        <t t-if="'daily_closing_cashiers' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Cashier Breakdown'"/><t t-set="rows" t-value="daily.get('cashiers', [])"/><t t-set="cols" t-value="[('cashier_name','Cashier'),('orders','Orders'),('total_sales','Basis'),('collected_amount','Collected'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'daily_closing_waiters' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Waiter Breakdown'"/><t t-set="rows" t-value="daily.get('waiters', [])"/><t t-set="cols" t-value="[('waiter_name','Waiter'),('orders','Orders'),('total_sales','Basis'),('quantity_sold','Qty'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'daily_closing_orders' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Order Summary'"/><t t-set="rows" t-value="daily.get('orders', [])"/><t t-set="cols" t-value="[('order_reference','Ref'),('date_order','Time'),('session_name','Session'),('cashier_name','Cashier'),('waiter_name','Waiter'),('total_amount','Total'),('paid_amount','Paid'),('return_amount','Return'),('payment_methods','Methods'),('order_state','State')]"/></t></t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_table">
        <div class="paa-section">
            <h3><t t-esc="title"/></h3>
            <table class="paa-table">
                <thead><tr><th t-foreach="cols" t-as="col"><t t-esc="col[1]"/></th></tr></thead>
                <tbody>
                    <tr t-if="not rows"><td t-att-colspan="len(cols)">No data for the selected filters.</td></tr>
                    <tr t-foreach="rows" t-as="row">
                        <td t-foreach="cols" t-as="col"><span t-esc="doc._format_report_value(row.get(col[0]))"/></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>
