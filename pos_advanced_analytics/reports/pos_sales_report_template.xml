<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_sales_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="payload" t-value="doc._report_payload()"/>
                <t t-set="kpis" t-value="payload.get('kpis', {})"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><t t-esc="payload.get('report_title')"/></h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Date Range:</strong>
                                <span t-esc="payload.get('filters', {}).get('date_start')"/> to
                                <span t-esc="payload.get('filters', {}).get('date_end')"/>
                            </div>
                            <div class="col-6">
                                <strong>POS Branch:</strong> <span t-esc="payload.get('branch_filter')"/>
                            </div>
                            <div class="col-6">
                                <strong>Generated By:</strong> <span t-esc="payload.get('generated_by')"/>
                            </div>
                            <div class="col-6">
                                <strong>Generated Date:</strong> <span t-esc="payload.get('generated_at')"/>
                            </div>
                        </div>

                        <h3>Executive Summary</h3>
                        <p>
                            This report summarizes POS operational sales analytics for valid paid, done, and invoiced orders.
                            It covers sales, orders, products, categories, branches, cashiers, waiters, payment methods,
                            refunds, discounts, taxes, and peak trading periods.
                        </p>

                        <h3>KPI Summary</h3>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td>Total Sales</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('total_sales', 0.0))"/></td><td>Net Sales</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('net_sales', 0.0))"/></td></tr>
                                <tr><td>Total Orders</td><td class="text-end"><span t-esc="kpis.get('total_orders', 0)"/></td><td>Average Order Value</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('average_order_value', 0.0))"/></td></tr>
                                <tr><td>Total Quantity Sold</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('total_quantity_sold', 0.0))"/></td><td>Total Tax</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('total_tax', 0.0))"/></td></tr>
                                <tr><td>Total Discounts</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('total_discounts', 0.0))"/></td><td>Total Refunds</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('total_refunds', 0.0))"/></td></tr>
                                <tr><td>Cash Sales</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('cash_sales', 0.0))"/></td><td>Bank/Card Sales</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('bank_card_sales', 0.0))"/></td></tr>
                                <tr><td>Mobile Money Sales</td><td class="text-end"><span t-esc="'{:,.2f}'.format(kpis.get('mobile_money_sales', 0.0))"/></td><td>Peak Sales Hour</td><td><span t-esc="kpis.get('peak_sales_hour')"/></td></tr>
                                <tr><td>Best Selling Product</td><td><span t-esc="kpis.get('best_selling_product')"/></td><td>Best Selling Category</td><td><span t-esc="kpis.get('best_selling_category')"/></td></tr>
                                <tr><td>Top Waiter</td><td><span t-esc="kpis.get('top_waiter')"/></td><td>Top Cashier</td><td><span t-esc="kpis.get('top_cashier')"/></td></tr>
                            </tbody>
                        </table>

                        <h3>Sales Breakdown</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Period</th><th class="text-end">Sales</th><th class="text-end">Net Sales</th><th class="text-end">Orders</th><th class="text-end">Tax</th></tr></thead>
                            <tbody>
                                <tr t-foreach="payload.get('sales_trend', [])" t-as="row">
                                    <td><span t-esc="row.get('label')"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('total_sales', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('net_sales', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="row.get('order_count', 0)"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('tax_amount', 0.0))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Daily Closing Report</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Date</th><th>Branch</th><th>Session</th><th>Cashier</th><th>Opening</th><th>Closing</th><th class="text-end">Sales</th><th class="text-end">Net</th><th class="text-end">Orders</th><th class="text-end">Cash</th><th class="text-end">Bank/Card</th><th class="text-end">Mobile</th><th class="text-end">Other</th><th class="text-end">Refunds</th><th class="text-end">Discounts</th><th class="text-end">Tax</th><th class="text-end">AOV</th></tr></thead>
                            <tbody>
                                <tr t-foreach="payload.get('daily_closing', [])" t-as="row">
                                    <td><span t-esc="row.get('business_date')"/></td><td><span t-esc="row.get('branch_name')"/></td><td><span t-esc="row.get('session_name')"/></td><td><span t-esc="row.get('cashier_name')"/></td><td><span t-esc="row.get('opening_time')"/></td><td><span t-esc="row.get('closing_time')"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('total_sales', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('net_sales', 0.0))"/></td><td class="text-end"><span t-esc="row.get('total_orders', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('cash_sales', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('bank_card_sales', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('mobile_money_sales', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('other_payment_methods', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('refunds', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('discounts', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('tax', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('average_order_value', 0.0))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Product Performance</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Product</th><th>Category</th><th class="text-end">Qty</th><th class="text-end">Gross Sales</th><th class="text-end">Net Sales</th><th class="text-end">Refund Qty</th><th class="text-end">Refund Amount</th></tr></thead>
                            <tbody>
                                <tr t-foreach="payload.get('top_products', [])" t-as="row">
                                    <td><span t-esc="row.get('product_name')"/></td><td><span t-esc="row.get('category_name')"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('quantity_sold', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('gross_sales', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('net_sales', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('refund_quantity', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('refund_amount', 0.0))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Category Performance</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Category</th><th class="text-end">Qty</th><th class="text-end">Gross Sales</th><th class="text-end">Net Sales</th><th class="text-end">Refund Qty</th><th class="text-end">Refund Amount</th></tr></thead>
                            <tbody>
                                <tr t-foreach="payload.get('top_categories', [])" t-as="row">
                                    <td><span t-esc="row.get('category_name')"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('quantity_sold', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('gross_sales', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('net_sales', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('refund_quantity', 0.0))"/></td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('refund_amount', 0.0))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Waiter Performance</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Waiter</th><th class="text-end">Sales</th><th class="text-end">Orders</th><th class="text-end">AOV</th><th class="text-end">Qty</th><th class="text-end">Refunds</th><th class="text-end">Discounts</th></tr></thead>
                            <tbody>
                                <tr t-foreach="payload.get('waiter_performance', [])" t-as="row">
                                    <td><span t-esc="row.get('waiter_name')"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('total_sales', 0.0))"/></td><td class="text-end"><span t-esc="row.get('total_orders', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('average_order_value', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('quantity_sold', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('refunds', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('discounts', 0.0))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Cashier Performance</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Cashier</th><th class="text-end">Collected</th><th class="text-end">Orders</th><th class="text-end">Average Ticket</th><th class="text-end">Refunds</th><th class="text-end">Discounts</th></tr></thead>
                            <tbody>
                                <tr t-foreach="payload.get('cashier_performance', [])" t-as="row">
                                    <td><span t-esc="row.get('cashier_name')"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('total_collected', 0.0))"/></td><td class="text-end"><span t-esc="row.get('number_of_orders', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('average_ticket_size', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('refunds', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('discounts', 0.0))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Peak Hours and Peak Days</h3>
                        <div class="row">
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>Hour</th><th class="text-end">Orders</th><th class="text-end">Sales</th></tr></thead>
                                    <tbody><tr t-foreach="payload.get('peak_hours', [])" t-as="row"><td><span t-esc="row.get('label')"/></td><td class="text-end"><span t-esc="row.get('order_count', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('sales_amount', 0.0))"/></td></tr></tbody>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>Day</th><th class="text-end">Orders</th><th class="text-end">Sales</th></tr></thead>
                                    <tbody><tr t-foreach="payload.get('peak_days', [])" t-as="row"><td><span t-esc="row.get('label')"/></td><td class="text-end"><span t-esc="row.get('order_count', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('sales_amount', 0.0))"/></td></tr></tbody>
                                </table>
                            </div>
                        </div>

                        <h3>Payment Method Breakdown</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Payment Method</th><th>Type</th><th class="text-end">Orders</th><th class="text-end">Amount</th></tr></thead>
                            <tbody><tr t-foreach="payload.get('payment_methods', [])" t-as="row"><td><span t-esc="row.get('payment_method_name')"/></td><td><span t-esc="row.get('method_type')"/></td><td class="text-end"><span t-esc="row.get('order_count', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('amount', 0.0))"/></td></tr></tbody>
                        </table>

                        <h3>Refund and Discount Summary</h3>
                        <t t-set="refund" t-value="payload.get('refund_discount_summary', {})"/>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td>Total Refund Amount</td><td class="text-end"><span t-esc="'{:,.2f}'.format(refund.get('total_refund_amount', 0.0))"/></td><td>Refund Order Count</td><td class="text-end"><span t-esc="refund.get('refund_order_count', 0)"/></td></tr>
                                <tr><td>Discount Amount</td><td class="text-end"><span t-esc="'{:,.2f}'.format(refund.get('discount_amount', 0.0))"/></td><td>Discounted Order Count</td><td class="text-end"><span t-esc="refund.get('discounted_order_count', 0)"/></td></tr>
                            </tbody>
                        </table>

                        <h3>Tax Summary</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Branch</th><th class="text-end">Orders</th><th class="text-end">Tax</th></tr></thead>
                            <tbody><tr t-foreach="payload.get('tax_summary', [])" t-as="row"><td><span t-esc="row.get('branch_name')"/></td><td class="text-end"><span t-esc="row.get('order_count', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('tax_amount', 0.0))"/></td></tr></tbody>
                        </table>

                        <h3>Branch Comparison</h3>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Branch</th><th class="text-end">Sales</th><th class="text-end">Net Sales</th><th class="text-end">Orders</th><th class="text-end">AOV</th><th>Top Product</th><th>Top Category</th><th>Peak Hour</th><th>Peak Day</th></tr></thead>
                            <tbody><tr t-foreach="payload.get('branch_comparison', [])" t-as="row"><td><span t-esc="row.get('branch_name')"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('total_sales', 0.0))"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('net_sales', 0.0))"/></td><td class="text-end"><span t-esc="row.get('total_orders', 0)"/></td><td class="text-end"><span t-esc="'{:,.2f}'.format(row.get('average_order_value', 0.0))"/></td><td><span t-esc="row.get('top_product')"/></td><td><span t-esc="row.get('top_category')"/></td><td><span t-esc="row.get('peak_hour')"/></td><td><span t-esc="row.get('peak_day')"/></td></tr></tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
