<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_sales_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="payload" t-value="doc._report_payload()"/>
                <t t-set="sections" t-value="payload.get('sections', [])"/>
                <t t-set="kpis" t-value="payload.get('kpis', {})"/>
                <t t-call="web.external_layout">
                    <style>
                        .paa-page { font-size: 11px; color: #111827; }
                        .paa-title { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
                        .paa-meta td { padding: 2px 6px; font-size: 10px; }
                        .paa-kpi-grid { display: table; width: 100%; border-spacing: 6px; margin: 10px 0; }
                        .paa-kpi { display: table-cell; width: 25%; background: #f3f4f6; border: 1px solid #e5e7eb; padding: 7px; border-radius: 4px; }
                        .paa-kpi-label { font-size: 9px; text-transform: uppercase; color: #6b7280; }
                        .paa-kpi-value { font-size: 14px; font-weight: 700; color: #111827; }
                        .paa-section { page-break-inside: avoid; margin-top: 14px; }
                        .paa-break { page-break-before: always; }
                        table.paa-table { width: 100%; border-collapse: collapse; font-size: 9px; margin-top: 5px; }
                        table.paa-table th { background: #1f4e79; color: white; padding: 4px; border: 1px solid #d1d5db; }
                        table.paa-table td { padding: 3px; border: 1px solid #d1d5db; }
                        .text-end { text-align: right; }
                    </style>
                    <div class="page paa-page">
                        <div class="paa-title"><t t-esc="payload.get('report_title')"/></div>
                        <p>Executive POS sales and operational analytics report. Basis: <strong t-esc="payload.get('basis_label')"/>.</p>
                        <table class="paa-meta">
                            <tr><td><strong>Date Range</strong></td><td><span t-esc="payload.get('filters', {}).get('date_start')"/> to <span t-esc="payload.get('filters', {}).get('date_end')"/></td><td><strong>Branch</strong></td><td><span t-esc="payload.get('branch_filter')"/></td></tr>
                            <tr><td><strong>Generated By</strong></td><td><span t-esc="payload.get('generated_by')"/></td><td><strong>Generated</strong></td><td><span t-esc="payload.get('generated_at')"/></td></tr>
                            <tr><td><strong>Timezone</strong></td><td><span t-esc="payload.get('filters', {}).get('timezone')"/></td><td><strong>Group By</strong></td><td><span t-esc="payload.get('group_by_label')"/></td></tr>
                        </table>

                        <t t-if="'kpis' in sections">
                            <div class="paa-section">
                                <h3>KPI Summary</h3>
                                <div class="paa-kpi-grid">
                                    <div class="paa-kpi"><div class="paa-kpi-label">Total Sales</div><div class="paa-kpi-value" t-esc="'{:,.2f}'.format(kpis.get('total_sales', 0.0))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Net Sales</div><div class="paa-kpi-value" t-esc="'{:,.2f}'.format(kpis.get('net_sales', 0.0))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Orders</div><div class="paa-kpi-value" t-esc="kpis.get('total_orders', 0)"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">AOV</div><div class="paa-kpi-value" t-esc="'{:,.2f}'.format(kpis.get('average_order_value', 0.0))"/></div>
                                </div>
                                <div class="paa-kpi-grid">
                                    <div class="paa-kpi"><div class="paa-kpi-label">Discounts</div><div class="paa-kpi-value" t-esc="'{:,.2f}'.format(kpis.get('total_discounts', 0.0))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Refunds</div><div class="paa-kpi-value" t-esc="'{:,.2f}'.format(kpis.get('total_refunds', 0.0))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Tax</div><div class="paa-kpi-value" t-esc="'{:,.2f}'.format(kpis.get('total_tax', 0.0))"/></div>
                                    <div class="paa-kpi"><div class="paa-kpi-label">Basis Metric</div><div class="paa-kpi-value" t-esc="'{:,.2f}'.format(kpis.get('basis_metric', 0.0))"/></div>
                                </div>
                            </div>
                        </t>

                        <t t-if="'target_summary' in sections and payload.get('target_summary')">
                            <t t-set="target" t-value="payload.get('target_summary', {})"/>
                            <div class="paa-section"><h3>Target Achievement</h3>
                                <table class="paa-table"><tr><th>Target Amount</th><th>Actual Sales</th><th>Achievement %</th><th>Remaining</th><th>Required Daily Sales</th><th>Orders Achievement %</th><th>AOV Achievement %</th></tr>
                                <tr><td class="text-end" t-esc="'{:,.2f}'.format(target.get('monthly_target', 0.0))"/><td class="text-end" t-esc="'{:,.2f}'.format(target.get('actual_sales', 0.0))"/><td class="text-end" t-esc="'{:,.2f}'.format(target.get('achievement_percentage', 0.0))"/><td class="text-end" t-esc="'{:,.2f}'.format(target.get('remaining_target', 0.0))"/><td class="text-end" t-esc="'{:,.2f}'.format(target.get('required_average_daily_sales', 0.0))"/><td class="text-end" t-esc="'{:,.2f}'.format(target.get('orders_target_achievement', 0.0))"/><td class="text-end" t-esc="'{:,.2f}'.format(target.get('avg_order_value_target_achievement', 0.0))"/></tr></table>
                            </div>
                        </t>

                        <t t-if="'grouped' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Grouped Summary'"/><t t-set="rows" t-value="payload.get('grouped_report', [])"/><t t-set="cols" t-value="[('group_label','Group'),('total_sales','Sales'),('net_sales','Net Sales'),('order_count','Orders'),('quantity_sold','Qty'),('average_order_value','AOV'),('tax','Tax'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'sales_trend' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Sales Trend'"/><t t-set="rows" t-value="payload.get('sales_trend', [])"/><t t-set="cols" t-value="[('label','Period'),('total_sales','Sales'),('net_sales','Net Sales'),('order_count','Orders'),('tax_amount','Tax')]"/></t></t>
                        <t t-if="'top_products' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Product Sales'"/><t t-set="rows" t-value="payload.get('top_products', [])"/><t t-set="cols" t-value="[('product_name','Product'),('category_name','Category'),('quantity_sold','Qty'),('gross_sales','Gross'),('net_sales','Net'),('discount_amount','Discount'),('refund_quantity','Refund Qty'),('refund_amount','Refund'),('average_unit_price','Avg Unit')]"/></t></t>
                        <t t-if="'top_categories' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Category Sales'"/><t t-set="rows" t-value="payload.get('top_categories', [])"/><t t-set="cols" t-value="[('category_name','Category'),('quantity_sold','Qty'),('gross_sales','Gross'),('net_sales','Net'),('discount_amount','Discount'),('refund_quantity','Refund Qty'),('refund_amount','Refund'),('product_count','Products')]"/></t></t>
                        <t t-if="'waiter_performance' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Waiter Performance'"/><t t-set="rows" t-value="payload.get('waiter_performance', [])"/><t t-set="cols" t-value="[('waiter_name','Waiter'),('total_sales','Sales'),('total_orders','Orders'),('average_order_value','AOV'),('quantity_sold','Qty'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'cashier_performance' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Cashier Performance'"/><t t-set="rows" t-value="payload.get('cashier_performance', [])"/><t t-set="cols" t-value="[('cashier_name','Cashier'),('total_collected','Collected'),('number_of_orders','Orders'),('average_ticket_size','Avg Ticket'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'branch_comparison' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Branch Comparison'"/><t t-set="rows" t-value="payload.get('branch_comparison', [])"/><t t-set="cols" t-value="[('branch_name','Branch'),('total_sales','Sales'),('net_sales','Net'),('total_orders','Orders'),('average_order_value','AOV'),('top_product','Top Product'),('top_category','Top Category'),('peak_hour','Peak Hour'),('peak_day','Peak Day')]"/></t></t>
                        <t t-if="'peak_hours' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Peak Hours'"/><t t-set="rows" t-value="payload.get('peak_hours', [])"/><t t-set="cols" t-value="[('label','Hour'),('order_count','Orders'),('sales_amount','Sales')]"/></t></t>
                        <t t-if="'peak_days' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Peak Days'"/><t t-set="rows" t-value="payload.get('peak_days', [])"/><t t-set="cols" t-value="[('label','Day'),('order_count','Orders'),('sales_amount','Sales')]"/></t></t>
                        <t t-if="'payment_methods' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Payment Methods'"/><t t-set="rows" t-value="payload.get('payment_analytics', {}).get('summary', payload.get('payment_methods', []))"/><t t-set="cols" t-value="[('payment_method_name','Method'),('method_type','Category'),('order_count','Orders'),('amount','Amount'),('percentage','Share %')]"/></t></t>
                        <t t-if="'tax_summary' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Tax Summary'"/><t t-set="rows" t-value="payload.get('tax_summary', [])"/><t t-set="cols" t-value="[('branch_name','Branch'),('order_count','Orders'),('tax_amount','Tax')]"/></t></t>

                        <t t-if="'refund_discount' in sections">
                            <t t-set="refund" t-value="payload.get('refund_discount_summary', {})"/>
                            <div class="paa-section"><h3>Refund &amp; Discount Summary</h3>
                                <table class="paa-table"><tr><th>Refund Total</th><th>Refund Orders</th><th>Refund Quantity</th><th>Discount Total</th><th>Discounted Orders</th></tr>
                                <tr><td class="text-end" t-esc="'{:,.2f}'.format(refund.get('total_refund_amount', 0.0))"/><td class="text-end" t-esc="refund.get('refund_order_count', 0)"/><td class="text-end" t-esc="'{:,.2f}'.format(refund.get('refund_quantity', 0.0))"/><td class="text-end" t-esc="'{:,.2f}'.format(refund.get('discount_amount', 0.0))"/><td class="text-end" t-esc="refund.get('discounted_order_count', 0)"/></tr></table>
                            </div>
                        </t>

                        <t t-if="'daily_closing' in sections"><div class="paa-break"/><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Summary'"/><t t-set="rows" t-value="payload.get('daily_closing_details', {}).get('summary', [])"/><t t-set="cols" t-value="[('business_date','Date'),('branch_name','Branch'),('session_name','Session'),('cashier_name','Cashier'),('opening_balance','Opening Balance'),('closing_balance','Closing Balance'),('total_sales','Sales'),('total_collected','Collected'),('net_sales','Net'),('total_orders','Orders'),('cash_sales','Cash'),('bank_card_sales','Bank/Card'),('mobile_money_sales','Mobile'),('refunds','Refunds'),('discounts','Discounts'),('tax','Tax'),('average_order_value','AOV')]"/></t></t>
                        <t t-if="'daily_closing_payments' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Payment Breakdown'"/><t t-set="rows" t-value="payload.get('daily_closing_details', {}).get('payments', [])"/><t t-set="cols" t-value="[('branch_name','Branch'),('session_name','Session'),('payment_method_name','Method'),('order_count','Orders'),('amount','Amount')]"/></t></t>
                        <t t-if="'daily_closing_cashiers' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Cashier Breakdown'"/><t t-set="rows" t-value="payload.get('daily_closing_details', {}).get('cashiers', [])"/><t t-set="cols" t-value="[('cashier_name','Cashier'),('orders','Orders'),('total_sales','Sales'),('collected_amount','Collected'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'daily_closing_waiters' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Waiter Breakdown'"/><t t-set="rows" t-value="payload.get('daily_closing_details', {}).get('waiters', [])"/><t t-set="cols" t-value="[('waiter_name','Waiter'),('orders','Orders'),('total_sales','Sales'),('quantity_sold','Qty'),('refunds','Refunds'),('discounts','Discounts')]"/></t></t>
                        <t t-if="'daily_closing_orders' in sections"><t t-call="pos_advanced_analytics.report_table"><t t-set="title" t-value="'Daily Closing Order Summary'"/><t t-set="rows" t-value="payload.get('daily_closing_details', {}).get('orders', [])"/><t t-set="cols" t-value="[('order_reference','Order'),('date_order','Time'),('branch_name','Branch'),('session_name','Session'),('cashier_name','Cashier'),('waiter_name','Waiter'),('total_amount','Total'),('tax','Tax'),('paid_amount','Paid'),('return_amount','Return'),('payment_methods','Payments'),('order_state','State')]"/></t></t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_table">
        <div class="paa-section">
            <h3><t t-esc="title"/></h3>
            <table class="paa-table">
                <thead><tr><th t-foreach="cols" t-as="col"><t t-esc="col[1]"/></th></tr></thead>
                <tbody>
                    <tr t-if="not rows"><td t-att-colspan="len(cols)">No data for the selected filters.</td></tr>
                    <tr t-foreach="rows" t-as="row">
                        <td t-foreach="cols" t-as="col"><span t-esc="doc._format_report_value(row.get(col[0]))"/></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>
