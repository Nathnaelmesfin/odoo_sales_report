<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pos_analytics" model="ir.module.category">
        <field name="name">POS Analytics</field>
        <field name="description">Advanced Point of Sale analytics permissions</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_pos_analytics_user" model="res.groups">
        <field name="name">POS Analytics User</field>
        <field name="category_id" ref="pos_advanced_analytics.module_category_pos_analytics"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_pos_analytics_manager" model="res.groups">
        <field name="name">POS Analytics Manager</field>
        <field name="category_id" ref="pos_advanced_analytics.module_category_pos_analytics"/>
        <field name="implied_ids" eval="[(4, ref('pos_advanced_analytics.group_pos_analytics_user'))]"/>
    </record>
</odoo>
