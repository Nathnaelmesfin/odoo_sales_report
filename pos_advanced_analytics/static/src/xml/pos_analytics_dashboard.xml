<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_advanced_analytics.Dashboard">
        <div class="o_pos_analytics_dashboard">
            <div class="o_pos_analytics_header">
                <div>
                    <h1>POS Advanced Analytics</h1>
                    <p>Live café and catering POS sales analytics in Africa/Addis_Ababa business time.</p>
                </div>
                <div class="o_pos_analytics_actions">
                    <button class="btn btn-secondary" t-on-click="loadData" t-att-disabled="state.loading">Refresh</button>
                    <button class="btn btn-outline-primary" t-on-click="openReportWizard">Reports</button>
                    <button class="btn btn-outline-primary" t-on-click="exportPdf">Export PDF</button>
                    <button class="btn btn-primary" t-on-click="exportExcel">Export Excel</button>
                </div>
            </div>

            <div class="o_pos_analytics_filters card">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-2">
                            <label>Date Range</label>
                            <select class="form-select" name="date_range" t-on-change="onFilterChange">
                                <option t-foreach="state.options.date_ranges || []" t-as="opt" t-key="opt[0]" t-att-value="opt[0]" t-att-selected="state.filters.date_range === opt[0]" t-esc="opt[1]"/>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label>Start Date</label>
                            <input class="form-control" name="date_start" type="date" t-att-value="state.filters.date_start" t-on-change="onFilterChange" t-att-disabled="state.filters.date_range !== 'custom'"/>
                        </div>
                        <div class="col-6 col-md-2">
                            <label>End Date</label>
                            <input class="form-control" name="date_end" type="date" t-att-value="state.filters.date_end" t-on-change="onFilterChange" t-att-disabled="state.filters.date_range !== 'custom'"/>
                        </div>
                        <div class="col-12 col-md-2">
                            <label>Report Basis</label>
                            <select class="form-select" name="report_basis" t-on-change="onFilterChange">
                                <option t-foreach="state.options.report_basis || []" t-as="opt" t-key="opt[0]" t-att-value="opt[0]" t-att-selected="state.filters.report_basis === opt[0]" t-esc="opt[1]"/>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label>Trend Group</label>
                            <select class="form-select" name="group_by" t-on-change="onFilterChange">
                                <option value="day" t-att-selected="state.filters.group_by === 'day'">Daily</option>
                                <option value="week" t-att-selected="state.filters.group_by === 'week'">Weekly</option>
                                <option value="month" t-att-selected="state.filters.group_by === 'month'">Monthly</option>
                                <option value="year" t-att-selected="state.filters.group_by === 'year'">Yearly</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label>POS Shop / Branch</label>
                            <select class="form-select" name="pos_config_ids" multiple="multiple" t-on-change="onFilterChange">
                                <option t-foreach="state.options.pos_configs || []" t-as="opt" t-key="opt.id" t-att-value="opt.id" t-att-selected="state.filters.pos_config_ids.includes(opt.id)" t-esc="opt.name"/>
                            </select>
                        </div>
                        <div t-if="(state.options.defaults || {}).enable_cashier_analytics" class="col-12 col-md-2">
                            <label>Cashier</label>
                            <select class="form-select" name="cashier_ids" multiple="multiple" t-on-change="onFilterChange">
                                <option t-foreach="state.options.cashiers || []" t-as="opt" t-key="opt.id" t-att-value="opt.id" t-att-selected="state.filters.cashier_ids.includes(opt.id)" t-esc="opt.name"/>
                            </select>
                        </div>
                        <div t-if="(state.options.defaults || {}).enable_waiter_analytics" class="col-12 col-md-2">
                            <label>Waiter</label>
                            <select class="form-select" name="waiter_ids" multiple="multiple" t-on-change="onFilterChange">
                                <option t-foreach="state.options.waiters || []" t-as="opt" t-key="opt.id" t-att-value="opt.id" t-att-selected="state.filters.waiter_ids.includes(opt.id)" t-esc="opt.name"/>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label>Product Category</label>
                            <select class="form-select" name="product_category_ids" multiple="multiple" t-on-change="onFilterChange">
                                <option t-foreach="state.options.categories || []" t-as="opt" t-key="opt.id" t-att-value="opt.id" t-att-selected="state.filters.product_category_ids.includes(opt.id)" t-esc="opt.name"/>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label>Product</label>
                            <select class="form-select" name="product_ids" multiple="multiple" t-on-change="onFilterChange">
                                <option t-foreach="state.options.products || []" t-as="opt" t-key="opt.id" t-att-value="opt.id" t-att-selected="state.filters.product_ids.includes(opt.id)" t-esc="opt.name"/>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label>Payment Method</label>
                            <select class="form-select" name="payment_method_ids" multiple="multiple" t-on-change="onFilterChange">
                                <option t-foreach="state.options.payment_methods || []" t-as="opt" t-key="opt.id" t-att-value="opt.id" t-att-selected="state.filters.payment_method_ids.includes(opt.id)" t-esc="opt.name"/>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="o_pos_analytics_loading card"><div class="card-body">Loading live POS analytics…</div></div>
            <div t-if="state.error" class="alert alert-danger"><strong>Error:</strong> <span t-esc="state.error"/></div>
            <div t-if="!state.loading and !state.error and !hasData" class="o_pos_analytics_empty card"><div class="card-body">No POS data was found for the selected filters.</div></div>

            <t t-if="hasData">
                <div class="o_pos_analytics_section_title">
                    <div>
                        <h2>Executive Overview</h2>
                        <p>Charts, leaderboards, and live operational tables are shown first so managers do not need to scroll through every KPI card.</p>
                    </div>
                </div>

                <div class="o_pos_analytics_headline_kpis">
                    <div class="o_pos_analytics_kpi o_pos_analytics_headline_kpi card" t-foreach="headlineKpiCards" t-as="kpi" t-key="kpi.key">
                        <div class="card-body">
                            <div class="o_pos_analytics_kpi_label" t-esc="kpi.label"/>
                            <div class="o_pos_analytics_kpi_value" t-esc="kpi.value"/>
                        </div>
                    </div>
                </div>

                <div class="row g-3 o_pos_analytics_top_grid">
                    <div class="col-12 col-xl-7">
                        <div class="card o_pos_analytics_panel o_pos_analytics_feature_panel">
                            <div class="card-header">Sales Trend</div>
                            <div class="card-body">
                                <t t-if="!(state.data.sales_trend || []).length"><div class="text-muted">No trend data.</div></t>
                                <svg t-if="(state.data.sales_trend || []).length" class="o_svg_line_chart" viewBox="0 0 320 110" preserveAspectRatio="none">
                                    <defs><linearGradient id="paaTrend" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#2563eb" stop-opacity=".35"/><stop offset="100%" stop-color="#2563eb" stop-opacity="0"/></linearGradient></defs>
                                    <line x1="0" y1="95" x2="320" y2="95" stroke="#cbd5e1" stroke-width="1"/><line x1="0" y1="5" x2="0" y2="95" stroke="#cbd5e1" stroke-width="1"/><polyline t-att-points="linePoints(state.data.sales_trend, 'total_sales')" fill="none" stroke="#2563eb" stroke-width="3"/><circle t-foreach="linePointMarkers(state.data.sales_trend, 'total_sales')" t-as="pt" t-key="pt.label" t-att-cx="pt.x" t-att-cy="pt.y" r="4" fill="#ffffff" stroke="#2563eb" stroke-width="2"><title><t t-esc="pt.label"/>: <t t-esc="formatValue(pt.value, 'currency')"/></title></circle>
                                </svg>
                                <div class="o_chart_labels"><span t-foreach="state.data.sales_trend || []" t-as="row" t-key="row.label"><t t-esc="row.label"/>: <strong t-esc="formatValue(row.total_sales, 'currency')"/></span></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-5">
                        <t t-call="pos_advanced_analytics.SvgBarChart"><t t-set="title" t-value="'Top Products'"/><t t-set="rows" t-value="state.data.top_products || []"/><t t-set="labelKey" t-value="'product_name'"/><t t-set="valueKey" t-value="'basis_amount'"/></t>
                    </div>
                    <div class="col-12 col-lg-4"><t t-call="pos_advanced_analytics.DonutChart"><t t-set="title" t-value="'Payment Method Breakdown'"/><t t-set="rows" t-value="state.data.payment_methods || []"/><t t-set="labelKey" t-value="'payment_method_name'"/><t t-set="valueKey" t-value="'amount'"/></t></div>
                    <div class="col-12 col-lg-4"><t t-call="pos_advanced_analytics.SvgBarChart"><t t-set="title" t-value="'Top Categories'"/><t t-set="rows" t-value="state.data.top_categories || []"/><t t-set="labelKey" t-value="'category_name'"/><t t-set="valueKey" t-value="'basis_amount'"/></t></div>
                    <div class="col-12 col-lg-4"><t t-call="pos_advanced_analytics.SvgBarChart"><t t-set="title" t-value="'Sales by Hour'"/><t t-set="rows" t-value="state.data.peak_hours || []"/><t t-set="labelKey" t-value="'label'"/><t t-set="valueKey" t-value="'sales_amount'"/></t></div>
                    <div t-if="(state.data.settings || {}).enable_waiter_analytics" class="col-12 col-xl-6"><t t-call="pos_advanced_analytics.WaiterTable"/></div>
                    <div t-if="(state.data.settings || {}).enable_cashier_analytics" class="col-12 col-xl-6"><t t-call="pos_advanced_analytics.CashierTable"/></div>
                    <div class="col-12"><t t-call="pos_advanced_analytics.BranchPerformanceTable"/></div>
                </div>

                <div class="o_pos_analytics_section_title mt-3">
                    <div>
                        <h2>Operational KPI Cards</h2>
                        <p>Additional POS indicators, peak-period metrics, and branch summaries.</p>
                    </div>
                </div>
                <div class="o_pos_analytics_kpis">
                    <div class="o_pos_analytics_kpi card" t-foreach="detailKpiCards" t-as="kpi" t-key="kpi.key">
                        <div class="card-body">
                            <div class="o_pos_analytics_kpi_label" t-esc="kpi.label"/>
                            <div class="o_pos_analytics_kpi_value" t-esc="kpi.value"/>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div t-if="(state.data.settings || {}).enable_target_cards" class="col-12 col-xl-4">
                        <div class="card o_pos_analytics_panel">
                            <div class="card-header">Target Summary</div>
                            <div class="card-body">
                                <t t-set="target" t-value="state.data.target_summary || {}"/>
                                <div class="o_target_line"><span>Monthly Target</span><strong t-esc="formatValue(target.monthly_target, 'currency')"/></div>
                                <div class="o_target_line"><span>Actual Sales</span><strong t-esc="formatValue(target.actual_sales, 'currency')"/></div>
                                <div class="o_target_line"><span>Achievement</span><strong><t t-esc="formatValue(target.achievement_percentage, 'number')"/>%</strong></div>
                                <div class="o_target_line"><span>Remaining</span><strong t-esc="formatValue(target.remaining_target, 'currency')"/></div>
                                <div class="o_target_line"><span>Required Average Daily Sales</span><strong t-esc="formatValue(target.required_average_daily_sales, 'currency')"/></div>
                                <div class="o_target_line"><span>Orders Target Achievement</span><strong><t t-esc="formatValue(target.orders_target_achievement, 'number')"/>%</strong></div>
                                <div class="o_target_line"><span>AOV Target Achievement</span><strong><t t-esc="formatValue(target.avg_order_value_target_achievement, 'number')"/>%</strong></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-4"><t t-call="pos_advanced_analytics.SvgBarChart"><t t-set="title" t-value="'Sales by Day'"/><t t-set="rows" t-value="state.data.peak_days || []"/><t t-set="labelKey" t-value="'label'"/><t t-set="valueKey" t-value="'sales_amount'"/></t></div>
                    <div class="col-12 col-xl-4"><t t-call="pos_advanced_analytics.HeatmapChart"/></div>
                    <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.SvgBarChart"><t t-set="title" t-value="'Branch Comparison'"/><t t-set="rows" t-value="state.data.branch_comparison || []"/><t t-set="labelKey" t-value="'branch_name'"/><t t-set="valueKey" t-value="'total_sales'"/></t></div>
                    <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.DonutChart"><t t-set="title" t-value="'Category Share'"/><t t-set="rows" t-value="state.data.top_categories || []"/><t t-set="labelKey" t-value="'category_name'"/><t t-set="valueKey" t-value="'basis_amount'"/></t></div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-12"><t t-call="pos_advanced_analytics.RefundDiscount"/></div>
                    <div class="col-12"><t t-call="pos_advanced_analytics.ProductDetailTable"/></div>
                    <div class="col-12"><t t-call="pos_advanced_analytics.CategoryDetailTable"/></div>
                    <div class="col-12"><t t-call="pos_advanced_analytics.PaymentDetailTables"/></div>
                    <div class="col-12"><t t-call="pos_advanced_analytics.RefundDiscountBreakdowns"/></div>
                </div>
            </t>
        </div>
    </t>

    <t t-name="pos_advanced_analytics.SvgBarChart">
        <div class="card o_pos_analytics_panel">
            <div class="card-header" t-esc="title"/>
            <div class="card-body">
                <div t-if="!rows.length" class="text-muted">No data.</div>
                <div class="o_svg_bar_row" t-foreach="chartRows(rows, labelKey, valueKey)" t-as="row" t-key="row.index">
                    <span class="o_svg_label" t-esc="row.label"/>
                    <svg viewBox="0 0 100 12" preserveAspectRatio="none"><rect x="0" y="1" width="100" height="10" rx="5" fill="#e5e7eb"/><rect x="0" y="1" t-att-width="row.width" height="10" rx="5" fill="#2563eb"><title><t t-esc="row.label"/>: <t t-esc="formatValue(row.value, 'currency')"/></title></rect></svg>
                    <span class="o_svg_value" t-esc="formatValue(row.value, 'currency')"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="pos_advanced_analytics.DonutChart">
        <div class="card o_pos_analytics_panel">
            <div class="card-header" t-esc="title"/>
            <div class="card-body o_donut_wrap">
                <div t-if="!rows.length" class="text-muted">No data.</div>
                <svg t-if="rows.length" class="o_donut_chart" viewBox="0 0 42 42">
                    <circle cx="21" cy="21" r="15.915" fill="transparent" stroke="#e5e7eb" stroke-width="6"/>
                    <circle t-foreach="donutSegments(rows, valueKey)" t-as="seg" t-key="seg.index" cx="21" cy="21" r="15.915" fill="transparent" t-att-stroke="seg.color" stroke-width="6" t-att-stroke-dasharray="seg.length + ' ' + (100 - seg.length)" t-att-stroke-dashoffset="seg.offset"><title><t t-esc="seg.row[labelKey]"/>: <t t-esc="formatValue(seg.row[valueKey], 'currency')"/></title></circle>
                </svg>
                <div class="o_donut_legend"><div t-foreach="chartRows(rows, labelKey, valueKey, 8)" t-as="row" t-key="row.index"><span t-esc="row.label"/> <strong t-esc="formatValue(row.value, 'currency')"/></div></div>
            </div>
        </div>
    </t>

    <t t-name="pos_advanced_analytics.HeatmapChart">
        <div class="card o_pos_analytics_panel">
            <div class="card-header">Peak Hours by Day Heatmap</div>
            <div class="card-body o_heatmap_grid">
                <div t-if="!(state.data.peak_hour_day_heatmap || []).length" class="text-muted">No heatmap data.</div>
                <div t-foreach="heatmapRows(state.data.peak_hour_day_heatmap || [])" t-as="row" t-key="row.label" class="o_heatmap_cell" t-att-style="'background: rgba(37, 99, 235,' + row.opacity + ')'">
                    <span t-esc="row.label"/><strong t-esc="formatValue(row.sales_amount, 'currency')"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="pos_advanced_analytics.WaiterTable">
        <div class="card o_pos_analytics_panel">
            <div class="card-header">Waiter Performance</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Waiter</th><th class="text-end">Sales</th><th class="text-end">Orders</th><th class="text-end">AOV</th><th class="text-end">Qty</th><th class="text-end">Refunds</th><th class="text-end">Discounts</th></tr></thead>
                    <tbody>
                        <tr t-if="!(state.data.waiter_performance || []).length"><td colspan="7" class="text-muted">No waiter data.</td></tr>
                        <tr t-foreach="state.data.waiter_performance || []" t-as="row" t-key="row.waiter_id || row.waiter_name">
                            <td t-esc="row.waiter_name"/><td class="text-end" t-esc="formatValue(row.total_sales, 'currency')"/><td class="text-end" t-esc="formatValue(row.total_orders, 'number')"/><td class="text-end" t-esc="formatValue(row.average_order_value, 'currency')"/><td class="text-end" t-esc="formatValue(row.quantity_sold, 'number')"/><td class="text-end" t-esc="formatValue(row.refunds, 'currency')"/><td class="text-end" t-esc="formatValue(row.discounts, 'currency')"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

    <t t-name="pos_advanced_analytics.CashierTable">
        <div class="card o_pos_analytics_panel">
            <div class="card-header">Cashier Performance</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Cashier</th><th class="text-end">Collected</th><th class="text-end">Orders</th><th class="text-end">Average Ticket</th><th class="text-end">Refunds</th><th class="text-end">Discounts</th><th>Payments</th></tr></thead>
                    <tbody>
                        <tr t-if="!(state.data.cashier_performance || []).length"><td colspan="7" class="text-muted">No cashier data.</td></tr>
                        <tr t-foreach="state.data.cashier_performance || []" t-as="row" t-key="row.cashier_id || row.cashier_name">
                            <td t-esc="row.cashier_name"/><td class="text-end" t-esc="formatValue(row.total_collected, 'currency')"/><td class="text-end" t-esc="formatValue(row.number_of_orders, 'number')"/><td class="text-end" t-esc="formatValue(row.average_ticket_size, 'currency')"/><td class="text-end" t-esc="formatValue(row.refunds, 'currency')"/><td class="text-end" t-esc="formatValue(row.discounts, 'currency')"/><td t-esc="formatValue(row.payment_method_breakdown, 'text')"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

    <t t-name="pos_advanced_analytics.RefundDiscount">
        <div class="card o_pos_analytics_panel">
            <div class="card-header">Refund and Discount Analytics</div>
            <div class="card-body o_refund_grid">
                <t t-set="refund" t-value="state.data.refund_discount_summary || {}"/>
                <div><span>Total Refund Amount</span><strong t-esc="formatValue(refund.total_refund_amount, 'currency')"/></div>
                <div><span>Refund Order Count</span><strong t-esc="formatValue(refund.refund_order_count, 'number')"/></div>
                <div><span>Discount Amount</span><strong t-esc="formatValue(refund.discount_amount, 'currency')"/></div>
                <div><span>Discounted Order Count</span><strong t-esc="formatValue(refund.discounted_order_count, 'number')"/></div>
            </div>
        </div>
    </t>

    <t t-name="pos_advanced_analytics.BranchPerformanceTable">
        <div class="card o_pos_analytics_panel"><div class="card-header">Branch Performance</div><div class="table-responsive"><table class="table table-hover mb-0">
            <thead><tr><th>Branch</th><th class="text-end">Basis</th><th class="text-end">Net</th><th class="text-end">Orders</th><th class="text-end">AOV</th><th>Top Product</th><th>Top Category</th><th>Peak Hour</th><th>Peak Day</th></tr></thead>
            <tbody><tr t-if="!(state.data.branch_comparison || []).length"><td colspan="9" class="text-muted">No branch data.</td></tr><tr t-foreach="state.data.branch_comparison || []" t-as="row" t-key="row.branch_id"><td t-esc="row.branch_name"/><td class="text-end" t-esc="formatValue(row.total_sales, 'currency')"/><td class="text-end" t-esc="formatValue(row.net_sales, 'currency')"/><td class="text-end" t-esc="formatValue(row.total_orders, 'number')"/><td class="text-end" t-esc="formatValue(row.average_order_value, 'currency')"/><td t-esc="row.top_product"/><td t-esc="row.top_category"/><td t-esc="row.peak_hour"/><td t-esc="row.peak_day"/></tr></tbody>
        </table></div></div>
    </t>

    <t t-name="pos_advanced_analytics.ProductDetailTable">
        <div class="card o_pos_analytics_panel"><div class="card-header">Product Details</div><div class="table-responsive"><table class="table table-hover mb-0">
            <thead><tr><th>Product</th><th>Category</th><th class="text-end">Qty</th><th class="text-end">Basis</th><th class="text-end">Gross</th><th class="text-end">Net</th><th class="text-end">Discounts</th><th class="text-end">Refund Qty</th><th class="text-end">Refund</th></tr></thead>
            <tbody><tr t-if="!(state.data.top_products || []).length"><td colspan="9" class="text-muted">No product data.</td></tr><tr t-foreach="state.data.top_products || []" t-as="row" t-key="row.product_id"><td t-esc="row.product_name"/><td t-esc="row.category_name"/><td class="text-end" t-esc="formatValue(row.quantity_sold, 'number')"/><td class="text-end" t-esc="formatValue(row.basis_amount, 'currency')"/><td class="text-end" t-esc="formatValue(row.gross_sales, 'currency')"/><td class="text-end" t-esc="formatValue(row.net_sales, 'currency')"/><td class="text-end" t-esc="formatValue(row.discount_amount, 'currency')"/><td class="text-end" t-esc="formatValue(row.refund_quantity, 'number')"/><td class="text-end" t-esc="formatValue(row.refund_amount, 'currency')"/></tr></tbody>
        </table></div></div>
    </t>

    <t t-name="pos_advanced_analytics.CategoryDetailTable">
        <div class="card o_pos_analytics_panel"><div class="card-header">Category Details</div><div class="table-responsive"><table class="table table-hover mb-0">
            <thead><tr><th>Category</th><th class="text-end">Qty</th><th class="text-end">Basis</th><th class="text-end">Gross</th><th class="text-end">Net</th><th class="text-end">Discounts</th><th class="text-end">Refund Qty</th><th class="text-end">Refund</th></tr></thead>
            <tbody><tr t-if="!(state.data.top_categories || []).length"><td colspan="8" class="text-muted">No category data.</td></tr><tr t-foreach="state.data.top_categories || []" t-as="row" t-key="row.category_id || row.category_name"><td t-esc="row.category_name"/><td class="text-end" t-esc="formatValue(row.quantity_sold, 'number')"/><td class="text-end" t-esc="formatValue(row.basis_amount, 'currency')"/><td class="text-end" t-esc="formatValue(row.gross_sales, 'currency')"/><td class="text-end" t-esc="formatValue(row.net_sales, 'currency')"/><td class="text-end" t-esc="formatValue(row.discount_amount, 'currency')"/><td class="text-end" t-esc="formatValue(row.refund_quantity, 'number')"/><td class="text-end" t-esc="formatValue(row.refund_amount, 'currency')"/></tr></tbody>
        </table></div></div>
    </t>

    <t t-name="pos_advanced_analytics.PaymentDetailTables">
        <div class="card o_pos_analytics_panel"><div class="card-header">Payment Analytics Details</div><div class="card-body">
            <div class="row g-3"><div class="col-12 col-lg-4"><t t-call="pos_advanced_analytics.PaymentMiniTable"><t t-set="title" t-value="'Payment Methods'"/><t t-set="rows" t-value="(state.data.payment_analytics || {}).summary || []"/></t></div><div class="col-12 col-lg-4"><t t-call="pos_advanced_analytics.PaymentMiniTable"><t t-set="title" t-value="'Payment by Branch'"/><t t-set="rows" t-value="(state.data.payment_analytics || {}).branch_breakdown || []"/></t></div><div t-if="(state.data.settings || {}).enable_cashier_analytics" class="col-12 col-lg-4"><t t-call="pos_advanced_analytics.PaymentMiniTable"><t t-set="title" t-value="'Payment by Cashier'"/><t t-set="rows" t-value="(state.data.payment_analytics || {}).cashier_breakdown || []"/></t></div></div>
        </div></div>
    </t>
    <t t-name="pos_advanced_analytics.PaymentMiniTable"><h6 t-esc="title"/><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Group/Method</th><th class="text-end">Orders</th><th class="text-end">Amount</th></tr></thead><tbody><tr t-if="!rows.length"><td colspan="3" class="text-muted">No data.</td></tr><tr t-foreach="rows" t-as="row" t-key="(row.group_label || row.payment_method_name) + row.amount"><td t-esc="row.group_label || row.payment_method_name"/><td class="text-end" t-esc="formatValue(row.order_count, 'number')"/><td class="text-end" t-esc="formatValue(row.amount, 'currency')"/></tr></tbody></table></div></t>

    <t t-name="pos_advanced_analytics.RefundDiscountBreakdowns">
        <div class="card o_pos_analytics_panel"><div class="card-header">Refund &amp; Discount Breakdowns</div><div class="card-body"><t t-set="refund" t-value="state.data.refund_discount_summary || {}"/><div class="row g-3">
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.RefundMiniTable"><t t-set="title" t-value="'Refund by Product'"/><t t-set="rows" t-value="refund.refund_by_product || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.RefundMiniTable"><t t-set="title" t-value="'Refund by Category'"/><t t-set="rows" t-value="refund.refund_by_category || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.RefundMiniTable"><t t-set="title" t-value="'Refund by Cashier'"/><t t-set="rows" t-value="refund.refund_by_cashier || []"/></t></div>
            <div t-if="(state.data.settings || {}).enable_waiter_analytics" class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.RefundMiniTable"><t t-set="title" t-value="'Refund by Waiter'"/><t t-set="rows" t-value="refund.refund_by_waiter || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.RefundMiniTable"><t t-set="title" t-value="'Refund by Branch'"/><t t-set="rows" t-value="refund.refund_by_branch || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.RefundMiniTable"><t t-set="title" t-value="'Refund by Date'"/><t t-set="rows" t-value="refund.refund_by_date || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.DiscountMiniTable"><t t-set="title" t-value="'Discount by Product'"/><t t-set="rows" t-value="refund.discount_by_product || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.DiscountMiniTable"><t t-set="title" t-value="'Discount by Category'"/><t t-set="rows" t-value="refund.discount_by_category || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.DiscountMiniTable"><t t-set="title" t-value="'Discount by Cashier'"/><t t-set="rows" t-value="refund.discount_by_cashier || []"/></t></div>
            <div t-if="(state.data.settings || {}).enable_waiter_analytics" class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.DiscountMiniTable"><t t-set="title" t-value="'Discount by Waiter'"/><t t-set="rows" t-value="refund.discount_by_waiter || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.DiscountMiniTable"><t t-set="title" t-value="'Discount by Branch'"/><t t-set="rows" t-value="refund.discount_by_branch || []"/></t></div>
            <div class="col-12 col-lg-6"><t t-call="pos_advanced_analytics.DiscountMiniTable"><t t-set="title" t-value="'Discount by Date'"/><t t-set="rows" t-value="refund.discount_by_date || []"/></t></div>
        </div></div></div>
    </t>
    <t t-name="pos_advanced_analytics.RefundMiniTable"><h6 t-esc="title"/><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Group</th><th class="text-end">Refund</th><th class="text-end">Qty</th><th class="text-end">Orders</th></tr></thead><tbody><tr t-if="!rows.length"><td colspan="4" class="text-muted">No data.</td></tr><tr t-foreach="rows" t-as="row" t-key="row.name"><td t-esc="row.name"/><td class="text-end" t-esc="formatValue(row.refund_amount, 'currency')"/><td class="text-end" t-esc="formatValue(row.refund_quantity, 'number')"/><td class="text-end" t-esc="formatValue(row.order_count, 'number')"/></tr></tbody></table></div></t>
    <t t-name="pos_advanced_analytics.DiscountMiniTable"><h6 t-esc="title"/><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Group</th><th class="text-end">Discount</th></tr></thead><tbody><tr t-if="!rows.length"><td colspan="2" class="text-muted">No data.</td></tr><tr t-foreach="rows" t-as="row" t-key="row.name"><td t-esc="row.name"/><td class="text-end" t-esc="formatValue(row.discount_amount, 'currency')"/></tr></tbody></table></div></t>

</templates>
